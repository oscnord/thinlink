table ip thinlink_router {
    # CGNAT emulation: vehicle_net may open flows to ground_net, ground_net only answers them.
    # ctl_net is never forwarded.
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ip saddr 192.168.231.0/24 ip daddr 192.168.232.0/24 accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr 192.168.231.0/24 ip daddr 192.168.232.0/24 masquerade
    }
}
